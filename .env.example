# .env.example —— 配置模板
#
# 这个文件的作用：告诉任何拿到这个仓库的人（包括三个月后的你自己）
# "这个程序需要准备哪几个配置"。
#
# 用法：把它复制成 .env，然后填上你自己的真实值。
#   PowerShell:  Copy-Item .env.example .env
#
# 两个文件的分工：
#   .env.example  进 git，所以里面绝对不能出现任何真实密码
#   .env          被 .gitignore 忽略，放真实值，只存在于你本机
#
# 注意：.env 只是一个普通文本文件，操作系统并不认识它。
# 是 config.go 里的 godotenv.Load() 把它读进进程的环境变量表的。


# ======== 必填：缺任何一项，程序会拒绝启动并告诉你缺哪个 ========
# 这三项没有默认值，因为默认值要么是秘密（密码），
# 要么在不同人的机器上本来就不一样（库名、用户名）。

DB_USER=postgres
DB_PASSWORD=在这里填你自己的数据库密码
DB_NAME=go_demo


# ======== 可选：不填就用下面这些默认值 ========
# 这些能有默认值，是因为默认值既不是秘密，又在多数情况下正确。

# 数据库地址。本机开发是 localhost；
# 到 Phase 7 跑在 Docker 里时，这里要改成 postgres 容器的服务名。
DB_HOST=localhost

# PostgreSQL 默认端口
DB_PORT=5432

# SSL 加密模式。本地开发关掉；真上线必须开。
DB_SSLMODE=disable

# HTTP 监听地址。冒号前留空表示监听所有网卡。
SERVER_ADDR=:8080

# 优雅关闭的宽限期：收到 Ctrl+C 后，最多再等多久让在途请求做完。
# 写法是 Go 的时长格式，例如 5s、30s、1m。
SHUTDOWN_TIMEOUT=5s
